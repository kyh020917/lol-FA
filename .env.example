# 디스코드 개발자 포털 > Bot > Token
DISCORD_TOKEN=

# https://developer.riotgames.com 의 Development API Key (24시간마다 만료)
RIOT_API_KEY=

# (선택) 이 서버 ID를 넣으면 슬래시 명령어가 즉시 등록됩니다. 비우면 전역 등록(반영까지 최대 1시간)
DEV_GUILD_ID=

# (선택) 게임 시작/종료 감시 간격(초). 기본 45
POLL_INTERVAL=45

# (선택) 일일 요약 기준 시간대. 기본 Asia/Seoul
TIMEZONE=Asia/Seoul

# (선택) 알림 채널이 만들어질 카테고리 이름
ALERT_CATEGORY_NAME=롤 알림

# (선택) DB 파일 경로
DB_PATH=data/lol_alert.db

# (선택) DEBUG / INFO / WARNING
LOG_LEVEL=INFO
